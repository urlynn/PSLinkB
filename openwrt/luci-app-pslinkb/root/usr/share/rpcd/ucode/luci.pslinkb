'use strict';

import { open, popen } from 'fs';
import * as ubus from 'ubus';

let _ubus = null;
function push_event(key, value) {
	try {
		if (!_ubus) _ubus = ubus.connect();
		_ubus.call('service', 'event', { type: 'pslinkb', data: { key: key, value: value } });
	} catch (e) {
		_ubus = null;
	}
}

// ── URLs ─────────────────────────────────────

const GH = 'https://github.com/urlynn';
const GH_PSLINKB = GH + '/PSLinkB';
const GH_API = 'https://api.github.com/repos/urlynn/PSLinkB/releases/latest';
const PSLINKB_URL = GH_PSLINKB;
const LUCI_URL = GH_PSLINKB + '/releases/latest';
const POST_INSTALL_URL = 'https://raw.githubusercontent.com/urlynn/PSLinkB/main/openwrt/pslinkb/post-install';

// ── Helpers ──────────────────────────────────

function ver_greater(a, b) {
	if (!a || !b) return false;
	a = split(a, '-')[0]; b = split(b, '-')[0];
	const ap = split(a, '.'), bp = split(b, '.');
	for (let i = 0; i < max(length(ap), length(bp)); i++) {
		const an = +(i < length(ap) ? ap[i] : 0);
		const bn = +(i < length(bp) ? bp[i] : 0);
		if (an > bn) return true; if (an < bn) return false;
	}
	return false;
}

function pkg_type() {
	let fd = open('/usr/bin/apk', 'r'); if (fd) { fd.close(); return 'apk'; }
	fd = open('/bin/opkg', 'r');        if (fd) { fd.close(); return 'opkg'; }
	return 'unknown';
}

function read_local_pslinkb_ver() {
	const bfd = open('/usr/bin/pslinkb', 'r');
	if (!bfd) return '';
	bfd.close();
	const af = open('/lib/apk/db/installed', 'r');
	if (af) {
		const re = regexp('P:pslinkb' + chr(10) + 'V:([^' + chr(10) + ']+)', '');
		const m = match(af.read('all'), re); af.close();
		if (m) return m[1];
	}
	const fd = open('/usr/lib/opkg/info/pslinkb.control', 'r');
	if (fd) {
		const re = regexp('Version:\\s*([^' + chr(10) + ']+)', '');
		const m = match(fd.read('all'), re); fd.close();
		if (m) return m[1];
	}
	const pf = popen('( pslinkb --version & pid=$!; sleep 1; kill $pid 2>/dev/null; wait $pid 2>/dev/null ) 2>/dev/null');
	if (pf) { let line = pf.read('line'); pf.close(); if (line) { line = trim(line); if (index(line, 'pslinkb') == 0) line = trim(substr(line, length('pslinkb'))); if (line) return line; } }
	return '';
}

function read_local_luci_ver() {
	const af = open('/lib/apk/db/installed', 'r');
	if (af) {
		const re = regexp('P:luci-app-pslinkb' + chr(10) + 'V:([^' + chr(10) + ']+)', '');
		const m = match(af.read('all'), re); af.close();
		if (m) return m[1];
	}
	const fd = open('/usr/lib/opkg/info/luci-app-pslinkb.control', 'r');
	if (fd) {
		const re = regexp('Version:\\s*([^' + chr(10) + ']+)', '');
		const m = match(fd.read('all'), re); fd.close();
		if (m) return m[1];
	}
	return '';
}

function read_state() {
	const fd = open('/tmp/pslinkb/state.json', 'r');
	if (!fd) return {};
	const text = fd.read('all') || '{}';
	fd.close();
	return json(text);
}

// ── GitHub API ─────────────────────

let _release_cache = null;
function fetch_release() {
	if (_release_cache) return _release_cache;
	const fd = popen('curl -sL --connect-timeout 10 --max-time 30 -H "Accept: application/vnd.github+json" ' + GH_API + ' 2>/dev/null');
	if (!fd) return null;
	const text = fd.read('all'); fd.close();
	if (!text || !length(text)) return null;
	const rel = json(text);
	if (!rel || !rel.tag_name) return null;
	_release_cache = rel;
	return rel;
}

// ── 架构检测 ──────────

function detect_arch() {
	const fd = open('/etc/openwrt_release', 'r');
	if (!fd) return { arch: '', method: '' };
	const text = fd.read('all') || ''; fd.close();
	const m = match(text, regexp("DISTRIB_ARCH='([^']+)'", ''));
	if (!m) return { arch: '', method: '' };
	const da = m[1];
	if (da == 'x86_64') return { arch: 'x86_64', method: 'pkg' };
	if (da == 'aarch64_generic') return { arch: 'aarch64', method: 'pkg' };
	if (da == 'aarch64_cortex-a53' || da == 'aarch64_cortex-a72' || da == 'aarch64_cortex-a76')
		return { arch: 'aarch64', method: 'targz' };
	return { arch: '', method: '' };
}

// ── Web 后端检测 ─────────────────────────────

function detect_web_variant() {
	const fd = popen("uci -q get nginx.global.uci_enable 2>/dev/null");
	if (!fd) return 'uhttpd';
	const line = trim(fd.read('line') || ''); fd.close();
	return (line == 'true') ? 'nginx' : 'uhttpd';
}

// ── 版本获取 ─────────────────────────────────

function fetch_latest() {
	const rel = fetch_release();
	if (!rel || !rel.tag_name) return '';
	let tag = rel.tag_name;
	if (substr(tag, 0, 1) == 'v') tag = substr(tag, 1);
	return trim(tag);
}

function fetch_luci_latest() {
	const rel = fetch_release();
	if (!rel || !rel.assets) return '';
	const re = regexp('([0-9]+\\.[0-9]+\\.[0-9]+)', '');
	const assets = rel.assets;
	for (let i = 0; i < length(assets); i++) {
		const name = assets[i].name || '';
		if (index(name, 'luci-app-pslinkb') >= 0) {
			const m = match(name, re);
			if (m) return m[1];
		}
	}
	return '';
}

// ── Methods ─────────────────────────────────

const methods = {

	// ── App Info ──────────────────────────────

	app_info: {
		call: function() {
			let bin = false, stream = false;
			const bfd = open('/usr/bin/pslinkb', 'r'); if (bfd) { bfd.close(); bin = true; }
			const sfd = open('/usr/bin/pslinkb-stream', 'r'); if (sfd) { sfd.close(); stream = true; }
			return { ver: read_local_pslinkb_ver(), luci_ver: read_local_luci_ver(), pslinkb_url: PSLINKB_URL, luci_url: LUCI_URL, pkg_type: pkg_type(), binary_installed: bin, stream_installed: stream };
		}
	},

	check_updates: {
		call: function() {
			const lv = read_local_pslinkb_ver(), ll = read_local_luci_ver();
			const latest = fetch_latest();
			const luci_latest = fetch_luci_latest();
			return { latest_ver: (latest && ver_greater(latest, lv)) ? latest : '', latest_luci: (luci_latest && ver_greater(luci_latest, ll)) ? luci_latest : '' };
		}
	},

	// ── Status ──────────────────────────────

	status_initial: {
		call: function() {
			const fd = open('/tmp/pslinkb/state.json', 'r');
			let state = {};
			if (fd) { const text = fd.read('all') || '{}'; fd.close(); state = json(text); }
			const pf = popen('pidof pslinkb 2>/dev/null');
			const pid = pf ? trim(pf.read('all') || '') : '';
			if (pf) pf.close();
			if (length(pid)) state.running = true;
			else state = { running: false };
			return state;
		}
	},

	// ── 服务控制 ──────────────────────────────

	svc_start:  { call: function() { let fd = popen('/etc/init.d/pslinkb start 2>&1'); if (fd) { let _ = fd.read('all'); fd.close(); } return { ok: true, state: read_state() }; } },
	svc_stop:   { call: function() { let fd = popen('/etc/init.d/pslinkb stop 2>&1'); if (fd) { let _ = fd.read('all'); fd.close(); } return { ok: true, state: read_state() }; } },
	svc_restart:{ call: function() { let fd = popen('/etc/init.d/pslinkb restart 2>&1'); if (fd) { let _ = fd.read('all'); fd.close(); } return { ok: true, state: read_state() }; } },
	svc_status: { call: function() { let fd = popen('pidof pslinkb 2>/dev/null'); let pid = fd ? trim(fd.read('all') || '') : ''; if (fd) fd.close(); return { running: !!length(pid) }; } },
	svc_confirm: {
		call: function() {
			const pf = popen('pidof pslinkb 2>/dev/null');
			const pid = pf ? trim(pf.read('all') || '') : '';
			if (pf) pf.close();
			const running = length(pid) > 0;
			const fd = open('/tmp/pslinkb/state.json', 'r');
			let state = {};
			if (fd) { const text = fd.read('all') || '{}'; fd.close(); state = json(text); }
			state.running = running;
			const wfd = open('/tmp/pslinkb/.state.json.tmp.confirm', 'w');
			if (wfd) { wfd.write(sprintf('%J', state)); wfd.close(); popen('mv -f /tmp/pslinkb/.state.json.tmp.confirm /tmp/pslinkb/state.json'); }
			push_event('running', running);
			return { ok: true, running: running };
		}
	},
	config_reload:{ call: function() { popen('kill -USR1 $(pidof pslinkb) 2>/dev/null'); return { ok: true }; } },

	dns_toggle: {
		args: { val: '0' },
		call: function(request) {
			const val = '' + request.args.val;
			if (val !== '1' && val !== '0') return { ok: false };
			popen('kill -HUP $(pgrep pslinkb) 2>/dev/null &');
			return { ok: true };
		}
	},

	// ── 日志 ──────────────────────────────────

	log_read: {
		args: { lines: 0 },
		call: function(request) {
			const n = (request.args.lines > 0) ? request.args.lines : 80;
			const fd = popen('tail -n ' + n + ' /tmp/pslinkb/log 2>/dev/null');
			if (!fd) return { text: '' };
			const text = fd.read('all') || ''; fd.close();
			return { text: text };
		}
	},
	log_clear: {
		call: function() {
			const fd = open('/tmp/pslinkb/log', 'w'); if (fd) fd.close();
			return { ok: true };
		}
	},

	// ── 安装/升级 ──────────────────────────────

	install_package: {
		args: { data: { type: 'pslinkb', version: '' } },
		call: function(request) {
			const type = request.args.data.type || 'pslinkb';
			const pt = pkg_type();
			const archInfo = detect_arch();
			if (!archInfo.arch) return { ok: false, error: 'arch?', log: 'DISTRIB_ARCH unreadable' };

			const rel = fetch_release();
			if (!rel) return { ok: false, error: 'GitHub API', log: 'unreachable' };

			let ver = request.args.data.version;
			if (!length(ver) || ver == '?') {
				ver = (type == 'pslinkb') ? fetch_latest() : fetch_luci_latest();
				if (!length(ver)) return { ok: false, error: 'version unknown', log: 'cannot determine version' };
			}

			const variant = detect_web_variant();
			let target_ext;
			if (type == 'pslinkb') {
				target_ext = (archInfo.method == 'targz') ? 'tar.gz' : ((pt == 'apk') ? 'apk' : 'ipk');
			} else {
				target_ext = (pt == 'apk') ? 'apk' : 'ipk';
			}

			let asset_url = '';
			const assets = rel.assets || [];
			for (let i = 0; i < length(assets); i++) {
				const name = assets[i].name || '';
				const url = assets[i].browser_download_url;
				if (!url) continue;
				if (type == 'pslinkb') {
					if (index(name, 'pslinkb') >= 0 && index(name, 'luci') < 0 &&
					    index(name, ver) >= 0 && index(name, 'openwrt') >= 0 &&
					    index(name, archInfo.arch) >= 0 && index(name, '.' + target_ext) >= 0) {
						asset_url = url; break;
					}
				} else {
					if (index(name, 'luci-app-pslinkb') >= 0 && index(name, variant) >= 0 &&
					    index(name, '.' + target_ext) >= 0) {
						asset_url = url; break;
					}
				}
			}
			if (!asset_url) return { ok: false, error: 'asset not found', log: 'no matching ' + type + ' for arch=' + archInfo.arch + ' ver=' + ver + ' ext=' + target_ext };

			const dl = '/tmp/pslinkb-install.' + target_ext;
			popen('/etc/init.d/pslinkb stop >/dev/null 2>&1');

			let r = popen('curl -sSL --connect-timeout 15 --max-time 120 -o ' + dl + ' "' + asset_url + '" 2>&1');
			let dlog = r ? (r.read('all') || '') : '';
			if (r) r.close();

			if (target_ext == 'tar.gz') {
				r = popen('cd /tmp && tar xzf ' + dl + ' -C / 2>&1 && chmod +x /usr/bin/pslinkb /usr/bin/pslinkb-stream 2>&1; echo EXIT:$?');
				let out = r ? (r.read('all') || '') : 'popen failed';
				if (r) r.close();
				popen('rm -f ' + dl);
				
				let pi = popen('curl -sSL --connect-timeout 10 --max-time 30 -o /tmp/pslinkb-post-install.$$ "' + POST_INSTALL_URL + '" 2>/dev/null && sh /tmp/pslinkb-post-install.$$ 2>&1; echo PI_EXIT:$?; rm -f /tmp/pslinkb-post-install.$$');
				let pilog = pi ? (pi.read('all') || '') : '';
				if (pi) pi.close();
				let ok_flag = index(out, 'EXIT:0') >= 0;
				return { ok: ok_flag, error: ok_flag ? '' : 'install failed', log: asset_url + '\n' + dlog + out + '\n[post-install]\n' + pilog };
			} else if (target_ext == 'apk') {
				r = popen('apk add --allow-untrusted ' + dl + ' 2>&1; echo EXIT:$?');
			} else {
				r = popen('opkg install ' + dl + ' 2>&1; echo EXIT:$?');
			}

			let out = r ? (r.read('all') || '') : 'popen failed';
			if (r) r.close();
			popen('rm -f ' + dl);

			let ok_flag = index(out, 'EXIT:0') >= 0;
			return { ok: ok_flag, error: ok_flag ? '' : 'install failed', log: asset_url + '\n' + dlog + out };
		}
	}
};

return { 'luci.pslinkb': methods };
