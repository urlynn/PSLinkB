{
	"luci-app-pslinkb": {
		"description": "Grant access to PSLinkB configuration",
		"read": {
			"uci": [ "pslinkb" ],
			"ubus": {
				"luci.pslinkb": [ "log_read", "status_initial", "app_info", "check_updates", "install_package", "svc_status" ],
				"service": [ "*" ]
			}
		},
		"write": {
			"uci": [ "pslinkb" ],
			"ubus": {
				"luci.pslinkb": [ "log_clear", "svc_start", "svc_stop", "svc_restart", "config_reload", "dns_toggle", "install_package" ]
			}
		}
	}
}
