{
	"luci-app-pslinkb": {
		"description": "Grant access to PSLinkB configuration",
		"read": {
			"uci": [ "pslinkb" ],
			"ubus": {
				"luci.pslinkb": [ "log_read", "status_initial", "app_info", "check_updates", "svc_status" ]
			}
		},
		"write": {
			"uci": [ "pslinkb" ],
			"ubus": {
				"luci.pslinkb": [ "log_clear", "svc_start", "svc_stop", "svc_restart", "svc_confirm", "config_reload", "dns_toggle", "install_package" ]
			}
		}
	}
}
