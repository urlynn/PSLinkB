#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90

PROG=/usr/bin/pslinkb
TMP_DIR=/tmp/pslinkb
DNS_CONF=/etc/dnsmasq.d/pslinkb.conf

start_service() {
    [ -x "$PROG" ] || {
        echo "pslinkb binary not found: $PROG"
        return 1
    }

    mkdir -p "$TMP_DIR"

    LIVE_MODE=$(/sbin/uci -q get pslinkb.live.live_mode)
    if [ "$LIVE_MODE" = "auto" ]; then
        curl -s -X POST http://127.0.0.1/cgi-bin/luci/pslinkb-dns-on >/dev/null &
    fi

    procd_open_instance
    procd_set_param command /bin/sh -c "exec $PROG 2>>$TMP_DIR/log"
    procd_set_param respawn 3600 5 30
    procd_close_instance
}

reload_service() {
    /etc/init.d/pslinkb restart
}

stop_service() {
    if [ -f "$DNS_CONF" ]; then
        curl -s -X POST http://127.0.0.1/cgi-bin/luci/pslinkb-dns-off >/dev/null &
    fi

    rm -rf "$TMP_DIR"
}

service_triggers() {
    procd_add_reload_trigger "pslinkb"
}
